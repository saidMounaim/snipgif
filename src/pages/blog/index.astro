---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { formatGuideDate, isoDate } from '../../lib/guides';

const guides = (await getCollection('blog')).sort(
	(a, b) => b.data.published.getTime() - a.data.published.getTime() || a.data.heading.localeCompare(b.data.heading),
);
---

<Layout
	title="GIF Guides and How-Tos | Snipgif"
	description="Step-by-step guides for making, sizing, and sharing GIFs: convert videos on iPhone, add GIFs to a README, and shrink large GIFs, all in your browser."
>
	<main class="mx-auto flex w-full max-w-3xl flex-col gap-8 px-4 pt-14 pb-16 sm:pt-20">
		<header class="flex flex-col gap-3">
			<h1 class="text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">Guides</h1>
			<p class="text-base text-pretty text-muted-foreground">
				Practical how-tos for turning videos into GIFs and getting them to the right size, on any device.
			</p>
		</header>
		{
			guides.length === 0 ? (
				<p class="text-muted-foreground">No guides yet. Check back soon.</p>
			) : (
				<ul class="flex flex-col gap-4">
					{guides.map(({ id, data }) => (
						<li class="relative flex flex-col gap-2 rounded-2xl border border-border bg-card p-5 shadow-sm transition-colors focus-within:ring-3 focus-within:ring-ring hover:border-ring/60">
							<h2 class="text-xl font-bold tracking-tight text-foreground">
								<!-- The stretched link makes the whole card clickable while the heading stays the link text. -->
								<a href={`/blog/${id}`} class="outline-none after:absolute after:inset-0 after:rounded-2xl">
									{data.heading}
								</a>
							</h2>
							<p class="text-pretty text-muted-foreground">{data.description}</p>
							<p class="text-sm text-muted-foreground">
								<time datetime={isoDate(data.published)}>{formatGuideDate(data.published)}</time>
							</p>
						</li>
					))}
				</ul>
			)
		}
	</main>
</Layout>
