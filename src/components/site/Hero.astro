---
import { ShieldCheck } from 'lucide-react';
import { Badge } from '@/components/ui/badge';

interface Props {
	// Plain lead-in, followed by the highlighted phrase in the brand gradient.
	lead: string;
	highlight: string;
	description: string;
}

const { lead, highlight, description } = Astro.props;
---

<div class="flex flex-col items-center gap-5 text-center">
	<Badge variant="secondary" className="h-7 gap-1.5 px-3 text-sm">
		<ShieldCheck aria-hidden="true" />
		Your files never leave your device
	</Badge>
	<h1 class="max-w-2xl text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">
		{lead} <span class="text-brand">{highlight}</span>
	</h1>
	<p class="max-w-xl text-base text-pretty text-muted-foreground sm:text-lg">{description}</p>
</div>
